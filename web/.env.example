# Which deployment to use: localnet or devnet
NEXT_PUBLIC_CLUSTER=localnet
# Overrides the RPC URL from the synced deployment file
NEXT_PUBLIC_RPC_URL=
# Set to 1 to offer a keypair wallet kept in localStorage, for demos with no browser extension
NEXT_PUBLIC_DEMO_WALLET=
# Base URL of the statements indexer
NEXT_PUBLIC_INDEXER_URL=
# Server only: the pool admin keypair as a JSON byte array, which turns on the demo price control
DEMO_ADMIN_SECRET=
