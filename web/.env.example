# 1 uses the chain and services on this machine (deployments/localnet.json, the indexer on port 8787)
# Unset uses the Mac mini's (deployments/macmini.json), which is what Vercel builds. npm run localnet sets 1 while it runs,
# and npm run dev:local or npm run dev:mac picks one either way
NEXT_PUBLIC_LOCAL=
# devnet uses the devnet deployment instead of either local chain
NEXT_PUBLIC_CLUSTER=
# Override the RPC, websocket and indexer URLs from the deployment file
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_WS_URL=
# Set to 0 to hide the keypair wallet kept in localStorage, which is there for demos with no browser extension
NEXT_PUBLIC_DEMO_WALLET=
# Base URL of the statements indexer
NEXT_PUBLIC_INDEXER_URL=
# Server only: the pool admin keypair as a JSON byte array, which turns on the demo price control
DEMO_ADMIN_SECRET=
# Server only: the faucet wallet keypair from scripts/.keys, which turns on the Get test tokens button
FAUCET_SECRET=
