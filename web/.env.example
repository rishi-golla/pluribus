# Which deployment to use: devnet unless this says localnet, and npm run localnet sets that by itself
NEXT_PUBLIC_CLUSTER=
# Overrides the RPC URL from the synced deployment file
NEXT_PUBLIC_RPC_URL=
# Set to 0 to hide the keypair wallet kept in localStorage, which is there for demos with no browser extension
NEXT_PUBLIC_DEMO_WALLET=
# Base URL of the statements indexer
NEXT_PUBLIC_INDEXER_URL=
# Server only: the pool admin keypair as a JSON byte array, which turns on the demo price control
DEMO_ADMIN_SECRET=
# Server only: the faucet wallet keypair from scripts/.keys, which turns on the Get test tokens button
FAUCET_SECRET=
